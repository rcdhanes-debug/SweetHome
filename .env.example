# ─── Server ────────────────────────────────────────────────────────────
PORT=5000

# MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/homehq
MONGODB_URI=mongodb://127.0.0.1:27017/homehq

# Secret used to sign short-lived admin/identity tokens
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime for a verified identity/admin session (seconds)
# Default: 300 (5 minutes)
TOKEN_TTL=300

# Client origin for CORS (used in production if client served elsewhere)
CLIENT_ORIGIN=http://localhost:5173

# ─── Telegram Bot Integration ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_group_chat_id_here

# ─── Keep Alive / Deployment ──────────────────────────────────────────
# Optional backend URL for self-ping keep-alive
SERVER_URL=https://your-backend-app.onrender.com

# ─── Seed configuration ────────────────────────────────────────────────
# Initial PINs used when the database is seeded.
SEED_PINS=Gowtham=1234,Harish=1234,Veera=1234,Ashwin=1234,Jegan=1234,Dhanesh=1234,Bhuvanesh=1234,Akash=1234,Bala=1234
SEED_DEFAULT_PIN=1234

# ─── Optional ──────────────────────────────────────────────────────────
LOG_LEVEL=dev
HOUSEHOLD_TZ=Asia/Kolkata
AUTO_SEED=true
