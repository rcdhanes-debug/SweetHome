# ─── Server ────────────────────────────────────────────────────────────
PORT=5000

# MongoDB connection string
# Example: mongodb://127.0.0.1:27017/homehq
MONGODB_URI=mongodb://127.0.0.1:27017/homehq

# Secret used to sign short-lived admin/identity tokens
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime for a verified identity/admin session (seconds)
# Default: 300 (5 minutes)
TOKEN_TTL=300

# Client origin for CORS (used in production if client served elsewhere)
CLIENT_ORIGIN=http://localhost:5173

# ─── Seed configuration ────────────────────────────────────────────────
# Initial PINs used when the database is seeded.
# Format: comma separated "Name=pin" entries. Omit a name to use SEED_DEFAULT_PIN.
# Example:
#   SEED_PINS=Gowtham=4321,Harish=9876
SEED_PINS=Gowtham=1234,Harish=1234,Veera=1234,Ashwin=1234,Jegan=1234,Dhanesh=1234,Bhuvanesh=1234,Akash=1234,Bala=1234
# Fallback PIN used for any user not listed in SEED_PINS.
SEED_DEFAULT_PIN=1234

# ─── Optional ──────────────────────────────────────────────────────────
# Log level for morgan (dev | combined)
LOG_LEVEL=dev

# Timezone used for funding months, deadline & chore days
HOUSEHOLD_TZ=Asia/Kolkata

# Run the idempotent bootstrap seed automatically on server start
AUTO_SEED=true
